<!DOCTYPE html>
<html>

<head>
    <title>Students</title>
</head>

<body>

    <h1>Student List</h1>

    <ul>
        <% students.forEach(student=> { %>
            <li>
                <%= student.id %> - <%= student.name %>
            </li>
            <% }) %>
    </ul>

    <h2>Add Student</h2>

    <form action="/add-student" method="POST">
        <input type="text" name="name" placeholder="Enter name" required />
        <button type="submit">Add</button>
    </form>

</body>

</html>